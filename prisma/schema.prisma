model OrderRecord {
  id                              Int       @id @default(autoincrement())
  
  // Core Identity
  status                          String?   @default("Open Order")
  customer                        String?
  agreementNumber                 String?   @map("agreement_number")
  poNumber                        String?   @map("po_number")
  releaseNumber                   String?   @map("release_number")
  lotNumber                       String?   @map("lot_number")
  ncr                             Boolean?  @default(false)
  sgsPONumber                     String?   @map("sgs_po_number")
  productDescription              String?   @map("product_description")
  comments                        String?
  partNumber                      String?   @map("part_number")
  fgNumber                        String?   @map("fg_number")
  process                         String?
  requiredBioTests                String?   @map("required_bio_tests")

  // Customer Supplied Ware
  dateAgreementPORcvd             DateTime? @map("date_agreement_po_rcvd")
  customerSuppliedWare            String?   @map("customer_supplied_ware")
  qtyRcvdCSWare                   Int?      @map("qty_rcvd_cs_ware")
  dateCSWareReceived              DateTime? @map("date_cs_ware_received")
  dateCSReceivingDocsSubmitted    DateTime? @map("date_cs_receiving_docs_submitted")
  dateCSDocumentsSavedToServer    DateTime? @map("date_cs_documents_saved_to_server")
  dateDACAssigned                 DateTime? @map("date_dac_assigned")

  // Work Order Dates
  dateWOCreatedQA                 DateTime? @map("date_wo_created_qa")
  dateWOApproved                  DateTime? @map("date_wo_approved")
  dateMaterialPulled              DateTime? @map("date_material_pulled")
  expectedStartWeek               String?   @map("expected_start_week")
  startDate                       DateTime? @map("start_date")
  startedDateMMYY                 String?   @map("started_date_mm_yy")

  // Bio Testing
  actualBioShipDate               DateTime? @map("actual_bio_ship_date")
  allResultsReceived              Boolean?  @map("all_results_received")
  dateBFSTestReportsRcvd          DateTime? @map("date_bfs_test_reports_rcvd")
  dateDTSTestReportsRcvd          DateTime? @map("date_dts_test_reports_rcvd")
  dateLALVALTestReportsRcvd       DateTime? @map("date_lalval_test_reports_rcvd")
  dateRLALTestReportsRcvd         DateTime? @map("date_rlal_test_reports_rcvd")

  // Completion & QA
  completionDate                  DateTime? @map("completion_date")
  completionDateBoxed             DateTime? @map("completion_date_boxed")
  reconciledDateMMYY              String?   @map("reconciled_date_mm_yy")
  dateWOSubmittedToQA             DateTime? @map("date_wo_submitted_to_qa")
  reviewedDateMMYY                String?   @map("reviewed_date_mm_yy")
  dateWOSubmittedToProduction     DateTime? @map("date_wo_submitted_to_production")
  quarantineWaiverCreated         DateTime? @map("quarantine_waiver_created")

  // Certification
  typeOfCertRequired              String?   @map("type_of_cert_required")
  totalOrderYield                 Int?      @map("total_order_yield")
  processedYieldDifferencePct     Float?    @map("processed_yield_difference_pct")
  dateRequestForCertSent          DateTime? @map("date_request_for_cert_sent")
  dateCertCreated                 DateTime? @map("date_cert_created")
  certReviewedAndApproved         DateTime? @map("cert_reviewed_and_approved")

  // Shipping & Quarantine
  quantityShippedSoFar            Int?      @map("quantity_shipped_so_far")
  quarantine                      Boolean?  @default(false)
  quantityParticulateSamples      Int?      @map("quantity_particulate_samples")
  dateParticulateSamplesCollected DateTime? @map("date_particulate_samples_collected")
  quantitySGSSamples              Int?      @map("quantity_sgs_samples")
  dateSGSSamplesCollected         DateTime? @map("date_sgs_samples_collected")

  // Quantities
  orderQuantityEaches             Int?      @map("order_quantity_eaches")
  orderQuantityTraysBags          Float?    @map("order_quantity_trays_bags")
  quantityPerTrayBag              Int?      @map("quantity_per_tray_bag")
  totalOrderBalance               Int?      @map("total_order_balance")

  // Pricing
  weekCodeStart                   String?   @map("week_code_start")
  pricePerUnit                    Float?    @map("price_per_unit")
  sublotPriceExpectedNonShipped   Float?    @map("sublot_price_expected_non_shipped")
  sublotPriceYieldNonShipped      Float?    @map("sublot_price_yield_non_shipped")
  weekCodeYield                   String?   @map("week_code_yield")
  expectedYieldPriceDiff          Float?    @map("expected_yield_price_diff")
  shippedPricePerUnit             Float?    @map("shipped_price_per_unit")
  sublotPriceExpected             Float?    @map("sublot_price_expected")
  sublotPriceYield                Float?    @map("sublot_price_yield")
  orderBalanceValue               Float?    @map("order_balance_value")
  quarantineReleaseRequired       Boolean?  @map("quarantine_release_required")

  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  @@map("order_records")
}

model ShippingLog {
  id                          Int       @id @default(autoincrement())
  status                      String?
  customer                    String?
  agreementPONumber           String?   @map("agreement_po_number")
  lotNumber                   String?   @map("lot_number")
  shipperNumber               String?   @map("shipper_number")
  productDescription          String?   @map("product_description")
  partNumber                  String?   @map("part_number")
  fgNumber                    String?   @map("fg_number")
  quantityPerTrayBag          Int?      @map("quantity_per_tray_bag")
  quarantineShipment          Boolean?  @map("quarantine_shipment")
  forecastedAmount            Int?      @map("forecasted_amount")
  totalOrderYield             Int?      @map("total_order_yield")
  shippedSoFar                Int?      @map("shipped_so_far")
  orderBalance                Int?      @map("order_balance")
  shipDate                    DateTime? @map("ship_date")
  shipQuantity                Int?      @map("ship_quantity")
  weekCodeShipped             String?   @map("week_code_shipped")
  pricePerUnit                Float?    @map("price_per_unit")
  sublotPriceYield            Float?    @map("sublot_price_yield")
  sublotPriceShipped          Float?    @map("sublot_price_shipped")
  yieldShippedPriceDiff       Float?    @map("yield_shipped_price_diff")
  sublotPriceForecasted       Float?    @map("sublot_price_forecasted")
  shippedSoFarValue           Float?    @map("shipped_so_far_value")
  forecastedShippedPriceDiff  Float?    @map("forecasted_shipped_price_diff")
  partialShipment             Boolean?  @map("partial_shipment")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@map("shipping_logs")
}

model NCRRecord {
  id                    Int       @id @default(autoincrement())
  customer              String?
  lotNumber             String?   @map("lot_number")
  ncrLotNumber          String?   @map("ncr_lot_number")
  productDescription    String?   @map("product_description")
  partNumber            String?   @map("part_number")
  comments              String?
  ncrCreatedDate        DateTime? @map("ncr_created_date")
  washStartDate         DateTime? @map("wash_start_date")
  boxedDate             DateTime? @map("boxed_date")
  reconciledDate        DateTime? @map("reconciled_date")
  reviewedDate          DateTime? @map("reviewed_date")
  totalOrderYield       Int?      @map("total_order_yield")
  certRequestSentDate   DateTime? @map("cert_request_sent_date")
  certifiedDate         DateTime? @map("certified_date")
  shipDate              DateTime? @map("ship_date")
  shipQuantity          Int?      @map("ship_quantity")
  totalOrderBalance     Int?      @map("total_order_balance")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("ncr_records")
}

model QuarantineRecord {
  id                    Int       @id @default(autoincrement())
  customer              String?
  releaseNumber         String?   @map("release_number")
  lotNumber             String?   @map("lot_number")
  productDescription    String?   @map("product_description")
  cleaningStartDate     DateTime? @map("cleaning_start_date")
  quarantineReleaseDate DateTime? @map("quarantine_release_date")
  quarantineReleased    Boolean?  @default(false) @map("quarantine_released")
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("quarantine_records")
}
