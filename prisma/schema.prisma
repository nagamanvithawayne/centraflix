generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  label       String
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  @@map("roles")
}

model Permission {
  id         Int     @id @default(autoincrement())
  roleId     Int
  module     String
  canView    Boolean @default(false)
  canCreate  Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)
  canExport  Boolean @default(false)
  canApprove Boolean @default(false)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([roleId, module])
  @@map("permissions")
}

model Department {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  code           String         @unique
  description    String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  employees      Employee[]
  machines       Machine[]
  deviations     Deviation[]
  processEntries ProcessEntry[]
  @@map("departments")
}

model User {
  id                 Int                @id @default(autoincrement())
  uuid               String             @unique @default(uuid())
  username           String             @unique
  email              String             @unique
  passwordHash       String
  roleId             Int
  employeeId         Int?               @unique
  isActive           Boolean            @default(true)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  role               Role               @relation(fields: [roleId], references: [id])
  employee           Employee?          @relation(fields: [employeeId], references: [id])
  sessions           Session[]
  auditLogs          AuditLog[]
  processEntries     ProcessEntry[]
  deviationsLogged   Deviation[]        @relation("ReportedBy")
  deviationsReviewed Deviation[]        @relation("ReviewedBy")
  machineStatusLogs  MachineStatusLog[]
  comments           Comment[]
  approvals          Approval[]
  trainingGiven      TrainingRecord[]   @relation("TrainedBy")
  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model Employee {
  id                 Int              @id @default(autoincrement())
  employeeCode       String           @unique
  fullName           String
  email              String           @unique
  phone              String?
  departmentId       Int
  badgeNumber        String?          @unique
  reportingManagerId Int?
  joiningDate        DateTime
  shift              String           @default("Day")
  isActive           Boolean          @default(true)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  department         Department       @relation(fields: [departmentId], references: [id])
  reportingManager   Employee?        @relation("Reports", fields: [reportingManagerId], references: [id])
  subordinates       Employee[]       @relation("Reports")
  user               User?
  trainingRecords    TrainingRecord[]
  assignedEntries    ProcessEntry[]   @relation("AssignedTo")
  @@map("employees")
}

model ProcessType {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  code           String           @unique
  description    String?
  sequence       Int              @default(0)
  departmentCode String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  subTypes       ProcessSubType[]
  trainingRecords TrainingRecord[]
  processEntries ProcessEntry[]
  deviations     Deviation[]
  workflowStages WorkflowStage[]
  @@map("process_types")
}

model ProcessSubType {
  id            Int            @id @default(autoincrement())
  processTypeId Int
  name          String
  code          String
  description   String?
  isActive      Boolean        @default(true)
  processType   ProcessType    @relation(fields: [processTypeId], references: [id], onDelete: Cascade)
  processEntries ProcessEntry[]
  deviations    Deviation[]
  @@unique([processTypeId, code])
  @@map("process_sub_types")
}

model TrainingRecord {
  id            Int            @id @default(autoincrement())
  employeeId    Int
  processTypeId Int
  status        TrainingStatus @default(PENDING)
  certifiedDate DateTime?
  expiryDate    DateTime?
  trainedById   Int?
  score         Float?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  processType   ProcessType    @relation(fields: [processTypeId], references: [id])
  trainedBy     User?          @relation("TrainedBy", fields: [trainedById], references: [id])
  @@unique([employeeId, processTypeId])
  @@map("training_records")
}

enum TrainingStatus {
  PENDING
  IN_PROGRESS
  CERTIFIED
  EXPIRED
  WAIVED
}

model WorkflowStage {
  id            Int            @id @default(autoincrement())
  processTypeId Int
  name          String
  sequence      Int
  department    String
  isRequired    Boolean        @default(true)
  canSkip       Boolean        @default(false)
  skipRoles     String?
  description   String?
  processType   ProcessType    @relation(fields: [processTypeId], references: [id])
  processEntries ProcessEntry[]
  @@unique([processTypeId, sequence])
  @@map("workflow_stages")
}

model TrayBatch {
  id             Int            @id @default(autoincrement())
  trayCode       String         @unique
  batchNumber    String         @unique
  productName    String
  quantity       Int
  unitOfMeasure  String         @default("units")
  currentStage   Int            @default(1)
  status         TrayStatus     @default(ACTIVE)
  assignedUserId Int?
  cleanroomRoute String?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  processEntries ProcessEntry[]
  deviations     Deviation[]
  comments       Comment[]
  @@map("trays_batches")
}

enum TrayStatus {
  ACTIVE
  ON_HOLD
  REWORK
  REJECTED
  COMPLETE
  SHIPPED
}

model ProcessEntry {
  id               Int             @id @default(autoincrement())
  trayBatchId      Int
  workflowStageId  Int?
  processTypeId    Int
  processSubTypeId Int?
  departmentId     Int?
  machineId        Int?
  performedById    Int
  assignedEmpId    Int?
  status           EntryStatus     @default(IN_PROGRESS)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  comments         String?
  parameters       Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  trayBatch        TrayBatch       @relation(fields: [trayBatchId], references: [id])
  workflowStage    WorkflowStage?  @relation(fields: [workflowStageId], references: [id])
  processType      ProcessType     @relation(fields: [processTypeId], references: [id])
  processSubType   ProcessSubType? @relation(fields: [processSubTypeId], references: [id])
  department       Department?     @relation(fields: [departmentId], references: [id])
  machine          Machine?        @relation(fields: [machineId], references: [id])
  performedBy      User            @relation(fields: [performedById], references: [id])
  assignedEmp      Employee?       @relation("AssignedTo", fields: [assignedEmpId], references: [id])
  @@map("process_entries")
}

enum EntryStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  ON_HOLD
  SKIPPED
}

model Machine {
  id           Int                @id @default(autoincrement())
  machineCode  String             @unique
  code         String             @unique
  name         String
  departmentId Int
  status       MachineStatus      @default(NORMAL)
  isActive     Boolean            @default(true)
  serialNumber String?
  model        String?
  manufacturer String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  department   Department         @relation(fields: [departmentId], references: [id])
  statusLogs   MachineStatusLog[]
  processEntries ProcessEntry[]
  deviations   Deviation[]
  @@map("machines")
}

model MachineStatusLog {
  id          Int           @id @default(autoincrement())
  machineId   Int
  oldStatus   MachineStatus
  newStatus   MachineStatus
  updatedById Int
  remarks     String?
  isDowntime  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  machine     Machine       @relation(fields: [machineId], references: [id])
  updatedBy   User          @relation(fields: [updatedById], references: [id])
  @@map("machine_status_logs")
}

enum MachineStatus {
  NORMAL
  NCR
  SPECIAL_PURPOSE
  OFFLINE
  MAINTENANCE
}

model Deviation {
  id               Int              @id @default(autoincrement())
  deviationCode    String           @unique
  ncrNumber        String?
  departmentId     Int
  processTypeId    Int?
  processSubTypeId Int?
  trayBatchId      Int?
  machineId        Int?
  reportedById     Int
  reviewedById     Int?
  issueCategory    String
  severity         DevSeverity
  description      String
  immediateAction  String?
  rootCause        String?
  correctiveAction String?
  status           DevStatus        @default(OPEN)
  qaComment        String?
  shareableRef     String           @unique @default(uuid())
  reportedAt       DateTime         @default(now())
  reviewedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  department       Department       @relation(fields: [departmentId], references: [id])
  processType      ProcessType?     @relation(fields: [processTypeId], references: [id])
  processSubType   ProcessSubType?  @relation(fields: [processSubTypeId], references: [id])
  trayBatch        TrayBatch?       @relation(fields: [trayBatchId], references: [id])
  machine          Machine?         @relation(fields: [machineId], references: [id])
  reportedBy       User             @relation("ReportedBy", fields: [reportedById], references: [id])
  reviewedBy       User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  media            DeviationMedia[]
  comments         Comment[]
  approvals        Approval[]
  @@map("deviations")
}

model DeviationMedia {
  id          Int       @id @default(autoincrement())
  deviationId Int
  fileType    String
  fileName    String
  filePath    String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime  @default(now())
  deviation   Deviation @relation(fields: [deviationId], references: [id], onDelete: Cascade)
  @@map("deviation_media")
}

enum DevSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DevStatus {
  OPEN
  UNDER_REVIEW
  QA_REVIEW_PENDING
  APPROVED
  REJECTED
  CLOSED
}

model Comment {
  id          Int        @id @default(autoincrement())
  userId      Int
  module      String
  trayBatchId Int?
  deviationId Int?
  content     String
  isInternal  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  trayBatch   TrayBatch? @relation(fields: [trayBatchId], references: [id])
  deviation   Deviation? @relation(fields: [deviationId], references: [id])
  @@map("comments")
}
model Approval {
  id        Int            @id @default(autoincrement())
  userId    Int
  module    String
  recordId  Int
  action    ApprovalAction
  remarks   String?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  deviation Deviation?     @relation(fields: [recordId], references: [id], map: "approval_dev_fk")
  @@map("approvals")
}

enum ApprovalAction {
  APPROVED
  REJECTED
  RETURNED
  ESCALATED
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

model ReportMeta {
  id            Int      @id @default(autoincrement())
  generatedById Int
  reportType    String
  filters       Json?
  format        String
  filePath      String?
  rowCount      Int?
  createdAt     DateTime @default(now())
  @@map("reports_metadata")
}
